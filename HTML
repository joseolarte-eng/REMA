@'
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Mapa de contenedores cercanos</title>
<style>
  body   { font-family: Arial, sans-serif; margin: 0; background: white; }
  .pagina { max-width: 750px; margin: 0 auto; }

  /* Mapa: se muestra solo la parte de arriba de la captura */
  .mapa  { width: 100%; aspect-ratio: 747 / 716; object-fit: cover; object-position: top; display: block; }

  .tarjeta { display: flex; gap: 10px; width: 370px; max-width: 90%;
             background: white; border-radius: 10px; padding: 8px;
             box-shadow: 0 2px 6px rgba(0,0,0,.25); margin: 30px 20px; position: relative; }
  .tarjeta.derecha { margin-left: auto; }

  /* Fotos: recortes de la misma captura */
  .foto { width: 100px; height: 110px; flex-shrink: 0; border-radius: 8px;
          background: url(captura.png) no-repeat; background-size: 667px auto; }
  .f1 { background-position: -38px -671px; }
  .f2 { background-position: -301px -813px; }

  .tarjeta h3 { margin: 0 0 8px; font-size: 20px; }
  .tarjeta p  { margin: 4px 0; font-size: 14px; }
  .punto { display: inline-block; width: 18px; height: 18px; border-radius: 50%; vertical-align: middle; margin-right: 6px; }
  .distancia { position: absolute; top: 8px; right: 12px; font-size: 12px; }
</style>
</head>
<body>
<div class="pagina">

  <!-- MAPA -->
  <img class="mapa" src="captura.png" alt="Mapa de contenedores cercanos: Av. Ayacucho, Gral. Acha, Santivañez y Nataniel Aguirre">

  <!-- TARJETAS -->
  <div class="tarjeta">
    <div class="foto f1" role="img" aria-label="Foto del contenedor"></div>
    <div>
      <h3>Contenedor Av. Ayacucho</h3>
      <p><span class="punto" style="background:#ffb040"></span>Medio Lleno</p>
      <p>Organicos, Reciclables</p>
    </div>
    <span class="distancia">50m</span>
  </div>

  <div class="tarjeta derecha">
    <div class="foto f2" role="img" aria-label="Foto del contenedor"></div>
    <div>
      <h3>Contenedor Av. Ayacucho</h3>
      <p><span class="punto" style="background:#e81212"></span>Lleno</p>
      <p>Organicos, Reciclables</p>
    </div>
    <span class="distancia">150m</span>
  </div>

</div>
</body>
</html>
'@ | Set-Content -Encoding UTF8 index.html 
