<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>MAPEO EN TIEMPO REAL | Seguimiento de Recolección</title>
  
  <!-- Tipografías Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  
  <!-- Hoja de estilos externa -->
  <link rel="stylesheet" href="styles.css" />
</head>
<body>

  <main>
    <!-- =========================================================
         1. SECCIÓN DE CONTENIDO (Aparece PRIMERO, antes del mapa)
         ========================================================= -->
    <section class="hero-location" aria-labelledby="hero-heading">
      
      <!-- Imagen de fondo relacionada con mapas/ubicación -->
      <img 
        src="https://images.unsplash.com/photo-1524661135-423995f22d0b?auto=format&fit=crop&w=1920&q=80" 
        alt="Persona visualizando un mapa de ubicación en tiempo real en su teléfono móvil" 
        class="hero-bg-image"
      />

      <!-- Superposición oscura para contraste -->
      <div class="hero-overlay" aria-hidden="true"></div>

      <!-- Título y texto superpuestos sobre la imagen -->
      <div class="hero-content">
        
        <div class="live-badge">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>Sistema GPS Activo</span>
        </div>

        <h1 id="hero-heading" class="hero-title">MAPEO EN TIEMPO REAL</h1>

        <p class="hero-subtitle">
          Averigua donde se encuentra el camión de basura en tiempo real para evitar preocupaciones.
        </p>

        <button id="btn-locate" class="btn-primary" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Ver unidad en el mapa
        </button>

      </div>
    </section>

    <!-- =========================================================
         2. SECCIÓN DEL MAPA (Aparece DESPUÉS del contenido)
         ========================================================= -->
    <section id="mapa-section" class="map-section" aria-labelledby="map-heading">
      <div class="map-container">
        
        <div class="map-header">
          <h2 id="map-heading" class="map-title">Ubicación en Vivo de Unidades</h2>
          <p class="map-description">Consulta el recorrido actual y el tiempo estimado de llegada a tu zona.</p>
        </div>

        <!-- Barra de estado interactiva -->
        <div id="status-panel" class="status-card" role="status" aria-live="polite">
          <span class="status-indicator"></span>
          <div>
            <h3 id="status-title">Unidad #402 — En ruta activa</h3>
            <p id="status-desc">Haz clic en "Ver unidad en el mapa" o selecciona una ruta para actualizar su posición.</p>
          </div>
        </div>

        <!-- Contenedor del mapa embebido -->
        <div class="map-frame-wrapper">
          <iframe 
            title="Mapa de rastreo de unidades en tiempo real"
            src="https://www.openstreetmap.org/export/embed.html?bbox=-68.1500%2C-16.5200%2C-68.1000%2C-16.4800&amp;layer=mapnik&amp;marker=-16.5000%2C-68.1250" 
            loading="lazy">
          </iframe>
        </div>

      </div>
    </section>
  </main>

  <!-- Lógica JavaScript externa -->
  <script src="app.js"></script>
</body>
</html>